{
  "family": "spry-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {"cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::416121583967:role/ecsTaskExecutionRole",
  "containerDefinitions": [{
    "name": "spry-backend",
    "image": "416121583967.dkr.ecr.eu-north-1.amazonaws.com/spry-backend:96f766b9806a5c5bcfbc35c4eadee39a44c49024",
    "essential": true,
    "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
    "environment": [
      { "name": "CORS_ORIGINS", "value": "https://app.spry-koval.me" }
    ],
    "secrets": [
      {
        "name": "DATABASE_URL",
        "valueFrom": "arn:aws:ssm:eu-north-1:416121583967:parameter/spry/DATABASE_URL"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/spry-backend",
        "awslogs-region": "eu-north-1",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }]
}
